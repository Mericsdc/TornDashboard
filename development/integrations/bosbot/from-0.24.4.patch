+"""Read-only extension devices. Only hashes of pairing secrets and tokens are stored."""
+import hashlib
+import secrets
+import time
+
+import aiosqlite
+from core import database
+
+PAIR_TTL = 300
+DEVICE_TTL = 30 * 86400
+SCHEMA = """
+CREATE TABLE IF NOT EXISTS dashboard_extension_pairs (
+ id TEXT PRIMARY KEY, secret_hash TEXT NOT NULL, extension_id TEXT NOT NULL,
+ expires_at INTEGER NOT NULL, guild_id INTEGER, user_id INTEGER, auth_mode TEXT
+);
+CREATE TABLE IF NOT EXISTS dashboard_extension_devices (
+ id TEXT PRIMARY KEY, token_hash TEXT NOT NULL UNIQUE, extension_id TEXT NOT NULL,
+ guild_id INTEGER NOT NULL, user_id INTEGER NOT NULL, auth_mode TEXT NOT NULL,
+ created_at INTEGER NOT NULL, expires_at INTEGER NOT NULL, revoked INTEGER NOT NULL DEFAULT 0
+);
+CREATE INDEX IF NOT EXISTS extension_devices_owner ON dashboard_extension_devices(guild_id, user_id);
+"""
+
+
+def digest(value):
+    return hashlib.sha256(value.encode()).hexdigest()
+
+
+async def start(extension_id):
+    now = int(time.time())
+    pair_id, secret = secrets.token_urlsafe(24), secrets.token_urlsafe(32)
+    async with aiosqlite.connect(database.DB_PATH) as db:
+        await db.execute("DELETE FROM dashboard_extension_pairs WHERE expires_at < ?", (now,))
+        await db.execute("DELETE FROM dashboard_extension_devices WHERE expires_at < ?", (now,))
+        async with db.execute("SELECT COUNT(*) FROM dashboard_extension_pairs") as cur:
+            if (await cur.fetchone())[0] >= 500:
+                raise ValueError("Pairing capacity reached")
+        await db.execute("INSERT INTO dashboard_extension_pairs(id, secret_hash, extension_id, expires_at) VALUES(?,?,?,?)",
+                         (pair_id, digest(secret), extension_id, now + PAIR_TTL))
+        await db.commit()
+    return {"pairingId": pair_id, "pollingSecret": secret, "expiresAt": (now + PAIR_TTL) * 1000}
+
+
+async def pairing(pair_id):
+    async with aiosqlite.connect(database.DB_PATH) as db:
+        db.row_factory = aiosqlite.Row
+        async with db.execute("SELECT * FROM dashboard_extension_pairs WHERE id=? AND expires_at>=?", (pair_id, int(time.time()))) as cur:
+            row = await cur.fetchone()
+    return dict(row) if row else None
+
+
+async def approve(pair_id, identity):
+    async with aiosqlite.connect(database.DB_PATH) as db:
+        cursor = await db.execute("""UPDATE dashboard_extension_pairs SET guild_id=?, user_id=?, auth_mode=?
+            WHERE id=? AND expires_at>=? AND user_id IS NULL""",
+            (identity.guild.id, identity.session.user_id, identity.auth_mode, pair_id, int(time.time())))
+        await db.commit()
+        return cursor.rowcount == 1
+
+
+async def poll(pair_id, secret, extension_id):
+    now = int(time.time())
+    async with aiosqlite.connect(database.DB_PATH) as db:
+        db.row_factory = aiosqlite.Row
+        await db.execute("BEGIN IMMEDIATE")
+        async with db.execute("""SELECT * FROM dashboard_extension_pairs
+            WHERE id=? AND secret_hash=? AND extension_id=? AND expires_at>=?""",
+            (pair_id, digest(secret), extension_id, now)) as cur:
+            row = await cur.fetchone()
+        if not row:
+            return {"status": "expired"}
+        if row["user_id"] is None:
+            return {"status": "pending"}
+        async with db.execute("""SELECT COUNT(*) FROM dashboard_extension_devices
+            WHERE guild_id=? AND user_id=? AND expires_at>=? AND revoked=0""", (row["guild_id"], row["user_id"], now)) as cur:
+            if (await cur.fetchone())[0] >= 10:
+                return {"status": "limit"}
+        token, device_id = secrets.token_urlsafe(48), secrets.token_urlsafe(24)
+        await db.execute("""INSERT INTO dashboard_extension_devices
+            (id,token_hash,extension_id,guild_id,user_id,auth_mode,created_at,expires_at) VALUES(?,?,?,?,?,?,?,?)""",
+            (device_id, digest(token), extension_id, row["guild_id"], row["user_id"], row["auth_mode"], now, now + DEVICE_TTL))
+        await db.execute("DELETE FROM dashboard_extension_pairs WHERE id=?", (pair_id,))
+        await db.commit()
+    return {"status": "approved", "token": token, "deviceId": device_id, "expiresAt": (now + DEVICE_TTL) * 1000}
+
+
+async def device(token, extension_id):
+    async with aiosqlite.connect(database.DB_PATH) as db:
+        db.row_factory = aiosqlite.Row
+        async with db.execute("""SELECT * FROM dashboard_extension_devices
+            WHERE token_hash=? AND extension_id=? AND expires_at>=? AND revoked=0""", (digest(token), extension_id, int(time.time()))) as cur:
+            row = await cur.fetchone()
+    return dict(row) if row else None
+
+
+async def devices(identity):
+    async with aiosqlite.connect(database.DB_PATH) as db:
+        db.row_factory = aiosqlite.Row
+        async with db.execute("""SELECT id, extension_id, created_at, expires_at FROM dashboard_extension_devices
+            WHERE guild_id=? AND user_id=? AND revoked=0 AND expires_at>=?""",
+            (identity.guild.id, identity.session.user_id, int(time.time()))) as cur:
+            return [dict(row) for row in await cur.fetchall()]
+
+
+async def revoke(device_id, guild_id, user_id):
+    async with aiosqlite.connect(database.DB_PATH) as db:
+        await db.execute("UPDATE dashboard_extension_devices SET revoked=1 WHERE id=? AND guild_id=? AND user_id=?", (device_id, guild_id, user_id))
+        await db.commit()
