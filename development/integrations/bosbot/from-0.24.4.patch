diff --git a/dashboard/extension_api.py b/dashboard/extension_api.py
new file mode 100644
index 0000000..b79b31b
--- /dev/null
+++ b/dashboard/extension_api.py
@@ -0,0 +1,167 @@
+"""Account-approved, revocable, read-only extension API. No website session is exported."""
+import hmac
+import re
+import time
+from collections import deque
+from html import escape
+from urllib.parse import urlencode
+
+from aiohttp import web
+from dashboard.auth import SessionData, identity_for_session
+from dashboard import extension_storage as store
+from dashboard.extension_feed import snapshot
+
+EXTENSION_ID = re.compile(r"^[a-p]{32}$")
+OPAQUE = re.compile(r"^[A-Za-z0-9_-]{20,100}$")
+
+
+class ExtensionApi:
+    def __init__(self, portal):
+        self.portal = portal
+        self.starts = deque(maxlen=100)
+        self.polls = {}
+        self.reads = {}
+
+    def register(self, app):
+        app.router.add_post("/api/extension/pair/start", self.start)
+        app.router.add_post("/api/extension/pair/poll", self.poll)
+        app.router.add_post("/api/extension/pair/approve", self.approve)
+        app.router.add_get("/api/extension/snapshot", self.feed)
+        app.router.add_delete("/api/extension/device", self.disconnect)
+        app.router.add_post("/api/extension/devices/revoke", self.revoke)
+        app.router.add_get("/extension/connect", self.connect_page)
+        app.router.add_get("/extension/devices", self.devices_page)
+
+    def origin(self, request, extension_id):
+        origin = request.headers.get("Origin")
+        if origin and origin != f"chrome-extension://{extension_id}":
+            raise web.HTTPForbidden(text="Invalid extension origin")
+
+    async def body(self, request):
+        if request.content_length and request.content_length > 2048:
+            raise web.HTTPRequestEntityTooLarge(max_size=2048, actual_size=request.content_length)
+        try:
+            body = await request.json()
+        except Exception:
+            raise web.HTTPBadRequest(text="Invalid request") from None
+        if not isinstance(body, dict):
+            raise web.HTTPBadRequest(text="Invalid request")
+        return body
+
+    def extension(self, value):
+        if not isinstance(value, str) or not EXTENSION_ID.fullmatch(value):
+            raise web.HTTPBadRequest(text="Invalid extension ID")
+        return value
+
+    def opaque(self, value):
+        if not isinstance(value, str) or not OPAQUE.fullmatch(value):
+            raise web.HTTPBadRequest(text="Invalid pairing request")
+        return value
+
+    async def start(self, request):
+        extension_id = self.extension((await self.body(request)).get("extensionId"))
+        self.origin(request, extension_id)
+        now = time.monotonic()
+        # Global bound protects SQLite even when remote addresses are behind a proxy.
+        if len(self.starts) >= 60 and now - self.starts[-60] < 60:
+            raise web.HTTPTooManyRequests(text="Try pairing again later", headers={"Retry-After": "60"})
+        self.starts.append(now)
+        try:
+            result = await store.start(extension_id)
+        except ValueError:
+            raise web.HTTPTooManyRequests(text="Try pairing again later") from None
+        result["verificationUrl"] = self.portal.public_url + "/extension/connect?" + urlencode({"pairingId": result["pairingId"]})
+        return web.json_response(result)
+
+    async def poll(self, request):
+        body = await self.body(request)
+        extension_id = self.extension(body.get("extensionId"))
+        pair_id, secret = self.opaque(body.get("pairingId")), self.opaque(body.get("pollingSecret"))
+        self.origin(request, extension_id)
+        now = time.monotonic()
+        if now - self.polls.get(pair_id, -10) < 1:
+            raise web.HTTPTooManyRequests(text="Poll no more than once per second", headers={"Retry-After": "1"})
+        self.polls = {key: value for key, value in self.polls.items() if now - value < 300}
+        if len(self.polls) >= 500 and pair_id not in self.polls:
+            raise web.HTTPTooManyRequests(text="Try pairing again later")
+        self.polls[pair_id] = now
+        return web.json_response(await store.poll(pair_id, secret, extension_id))
+
+    async def device(self, request):
+        if not request.headers.get("Authorization", "").startswith("Bearer "):
+            raise web.HTTPUnauthorized(text="Connect your BOSBOT account in extension settings")
+        extension_id = self.extension(request.headers.get("X-Extension-Id"))
+        self.origin(request, extension_id)
+        header = request.headers.get("Authorization", "")
+        token = header[7:] if header.startswith("Bearer ") else ""
+        if not OPAQUE.fullmatch(token):
+            raise web.HTTPUnauthorized(text="Connect your BOSBOT account in extension settings")
+        device = await store.device(token, extension_id)
+        if not device:
+            raise web.HTTPUnauthorized(text="BOSBOT connection expired or revoked; reconnect in extension settings")
+        session = SessionData(device["guild_id"], device["user_id"], "", device["expires_at"], device["auth_mode"])
+        identity = await identity_for_session(self.portal.bot, session)
+        if not identity:
+            raise web.HTTPForbidden(text="Your BOSBOT account no longer has access")
+        return device, identity
+
+    async def feed(self, request):
+        device, identity = await self.device(request)
+        now = time.monotonic()
+        if now - self.reads.get(device["id"], -10) < 1:
+            raise web.HTTPTooManyRequests(text="Refresh no more than once per second", headers={"Retry-After": "1"})
+        self.reads = {key: value for key, value in self.reads.items() if now - value < 300}
+        if len(self.reads) >= 5000 and device["id"] not in self.reads:
+            raise web.HTTPTooManyRequests(text="Try refreshing again later")
+        self.reads[device["id"]] = now
+        allowed = await self.portal._allowed_pages(identity)
+        return web.json_response(await snapshot(identity, allowed))
+
+    async def disconnect(self, request):
+        device, identity = await self.device(request)
+        await store.revoke(device["id"], identity.guild.id, identity.session.user_id)
+        return web.json_response({"revoked": True})
+
+    def page(self, title, content):
+        return web.Response(text=f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BOSBOT · {escape(title)}</title><link rel="stylesheet" href="/assets/extension.css"></head><body><main><h1>{escape(title)}</h1>{content}</main></body></html>', content_type="text/html", headers={"Cache-Control": "no-store", "Referrer-Policy": "no-referrer"})
+
+    async def connect_page(self, request):
+        pair_id = self.opaque(request.query.get("pairingId"))
+        pair = await store.pairing(pair_id)
+        if not pair:
+            return self.page("Pairing expired", "<p>Start a new connection in Torn Companion settings.</p>")
+        try:
+            identity = await self.portal._identity(request, admin=False)
+        except web.HTTPUnauthorized:
+            return self.page("Connect Torn Companion", '<p>Log in to BOSBOT in a separate tab, then reload this page.</p><a href="/" target="_blank" rel="noopener">Log in to BOSBOT</a><p><a href="">I have logged in · reload</a></p>')
+        return self.page("Connect Torn Companion", f'<p>Account: <strong>{escape(identity.username)}</strong></p><p>This browser can read the war, targets, chain, travel and restock sections your account can access. It cannot post Discord messages or access API keys.</p><p>Approve only a connection you started. Compare this ID with the one in extension settings:</p><code>{escape(pair["extension_id"])}</code><form method="post" action="/api/extension/pair/approve"><input type="hidden" name="pairingId" value="{escape(pair_id)}"><input type="hidden" name="csrf" value="{escape(identity.session.csrf_token)}"><button>Approve read-only connection</button></form><a href="/extension/devices">Manage connected browsers</a>')
+
+    async def form_identity(self, request):
+        if request.headers.get("Origin") != self.portal.public_url:
+            raise web.HTTPForbidden(text="Invalid website origin")
+        if request.content_length and request.content_length > 2048:
+            raise web.HTTPBadRequest(text="Invalid request")
+        identity = await self.portal._identity(request, admin=False)
+        body = await request.post()
+        if not hmac.compare_digest(str(body.get("csrf", "")), identity.session.csrf_token):
+            raise web.HTTPForbidden(text="Invalid CSRF token")
+        return identity, body
+
+    async def approve(self, request):
+        identity, body = await self.form_identity(request)
+        if not await store.approve(self.opaque(body.get("pairingId")), identity):
+            raise web.HTTPBadRequest(text="Pairing expired or already approved")
+        return self.page("Connection approved", "<p>Return to Torn Companion settings. The connection will complete automatically.</p><a href='/extension/devices'>Manage connected browsers</a>")
+
+    async def devices_page(self, request):
+        identity = await self.portal._identity(request, admin=False)
+        rows = await store.devices(identity)
+        content = "<p>Connections expire after 30 days. Revocation takes effect on the next refresh.</p>"
+        for row in rows:
+            content += f'<form method="post" action="/api/extension/devices/revoke"><code>{escape(row["extension_id"])}</code><input type="hidden" name="deviceId" value="{escape(row["id"])}"><input type="hidden" name="csrf" value="{escape(identity.session.csrf_token)}"><button>Revoke</button></form>'
+        return self.page("Connected browsers", content or "<p>No browsers connected.</p>")
+
+    async def revoke(self, request):
+        identity, body = await self.form_identity(request)
+        await store.revoke(self.opaque(body.get("deviceId")), identity.guild.id, identity.session.user_id)
+        raise web.HTTPSeeOther(location="/extension/devices")
diff --git a/dashboard/extension_feed.py b/dashboard/extension_feed.py
