--- /dev/null
+++ b/dashboard/extension_feed.py
@@ -0,0 +1,167 @@
+"""Translate BOSBOT's shared portal caches into the companion contract; never expose keys."""
+import asyncio
+import math
+import time
+
+from core.utils import safe_int
+from dashboard import data
+from dashboard.storage import user_torn_link
+from dashboard.operations_storage import list_restock_favorites_v2
+from monitors import restock
+from dashboard.extension_personal import personal_data, company_summary
+
+
+def ms(value):
+    return safe_int(value) * 1000 or None
+
+
+def text(value, limit=80):
+    return str(value or "")[:limit]
+
+
+def observed(key, ttl):
+    cached = data._CACHE.get(key)
+    return int((time.time() - max(0, ttl - (cached[0] - time.monotonic()))) * 1000) if cached else int(time.time() * 1000)
+
+
+def stock_item(item, country):
+    intervals = [safe_int(v) for v in item.get("intervalHistory", []) if restock.MIN_INTERVAL <= safe_int(v) <= restock.MAX_INTERVAL][-20:]
+    last = safe_int(item.get("lastRestock"))
+    prediction = safe_int(item.get("nextRestock"))
+    estimate = {"kind": "unknown", "reason": "BOSBOT has insufficient recent restock observations"}
+    if len(intervals) >= 2 and prediction > int(time.time()) and last:
+        avg = restock._weighted_avg(intervals)
+        spread = max(60, max(abs(interval - avg) for interval in intervals), int(avg * 0.15))
+        estimate = {"kind": "estimated", "earliest": (prediction - spread) * 1000,
+                    "latest": (prediction + spread) * 1000, "confidence": "medium" if len(intervals) >= 5 else "low",
+                    "samples": len(intervals), "lastSeenRestock": last * 1000, "intervalHistory": [v * 1000 for v in intervals]}
+    at = ms(item.get("observedAt"))
+    fresh = at and -30000 <= int(time.time() * 1000) - at <= 180000
+    return {"itemId": safe_int(item["itemId"]), "name": text(item["name"]), "country": text(country, 60),
+            "cost": safe_int(item.get("cost")) or None, "tornValue": safe_int(item.get("marketValue")) or None,
+            "priceObservedAt": ms(item.get("priceObservedAt")),
+            "stock": max(0, safe_int(item.get("quantity"))) if fresh else None, "observedAt": at, "restock": estimate if fresh else {"kind": "unknown", "reason": "BOSBOT source observation is stale or unavailable"}}
+
+
+def verified_stats(raw):
+    if not isinstance(raw, dict) or raw.get("isFallback") or str(raw.get("source", "")).startswith("BOS level"):
+        return None
+    value = raw.get("estimate")
+    return value if isinstance(value, (int, float)) and math.isfinite(value) and value > 0 else None
+
+
+def map_targets(source, presence):
+    personal = source.get("personalPower") or {}
+    known_power = verified_stats(personal)
+    preferred = [r for r in source.get("recommendedTargets", []) if known_power and verified_stats(r.get("battleStats"))]
+    priority = {safe_int(r.get("tornId")): i for i, r in enumerate(preferred)}
+    rows = list(source.get("targets") or [])
+    rows.sort(key=lambda row: (priority.get(safe_int(row.get("tornId")), len(priority)), not row.get("assigned", False), -safe_int(row.get("recommendationScore"))))
+    at = ms(presence.get("updatedAt")) or ms(source.get("updatedAt")) or 0
+    current = presence.get("targets") or {}
+    result = []
+    for row in rows[:200]:
+        if presence.get("warId") and str(row.get("tornId")) not in current:
+            continue
+        live = current.get(str(row.get("tornId")), row)
+        state = live.get("state") or "Unknown"
+        if state not in {"Okay", "Hospital", "Traveling", "Abroad", "Federal"}:
+            state = "Unknown"
+        stats = verified_stats(row.get("battleStats"))
+        reasons = [text(reason, 200) for reason in live.get("recommendationReasons", [])][:8]
+        if row.get("assigned"):
+            reasons.insert(0, "Assigned to you in BOSBOT War Plan")
+        match = next((r for r in preferred if safe_int(r.get("tornId")) == safe_int(row.get("tornId"))), None)
+        if match and match.get("matchReason"):
+            reasons.insert(0, text(match["matchReason"], 200))
+        if not stats:
+            reasons.append("Battle stats unknown; no level-based strength estimate is used")
+        result.append({"id": safe_int(row["tornId"]), "name": text(row.get("name")), "level": safe_int(row.get("level")) or None,
+                       "status": state, "activity": str(live.get("lastAction", "unknown")).lower() if str(live.get("lastAction", "")).lower() in {"online", "idle", "offline"} else "unknown",
+                       "observedAt": at, "hospitalUntil": ms(live.get("statusUntil")) if state == "Hospital" else None,
+                       "wins": None, "losses": None, "battleStats": stats,
+                       "statsSource": text((row.get("battleStats") or {}).get("source")) if stats else None,
+                       "recommendation": {"score": safe_int(live.get("recommendationScore")), "reasons": reasons[:10],
+                                          "confidence": {"High": "high", "Medium": "medium", "Low": "low"}.get((row.get("battleStats") or {}).get("confidence"), "low") if stats else "low", "label": "BOSBOT recommendation" if row["tornId"] in priority else "BOSBOT availability"}})
+    return result
+
+
+async def snapshot(identity, allowed):
+    result = {"source": "live", "provider": "bosbot", "generatedAt": int(time.time() * 1000), "war": None, "chain": None,
+              "travel": None, "company": None, "player": {"level": None}, "targets": [], "stocks": [], "favorites": [], "issues": {}}
+
+    async def section(key, loader):
+        try:
+            await asyncio.wait_for(loader(), timeout=18)
+        except Exception:
+            # Provider errors may contain credential URLs. Return fixed public messages only.
+            result["issues"][key] = "BOSBOT data is temporarily unavailable"
+
+    async def war():
+        row = await data._cached("targets:current-war-context", 60, data._current_ranked_war)
+        result["war"] = {"active": bool(row and row.get("phase") == "active"), "id": safe_int((row or {}).get("id")) or None, "opponentId": safe_int((row or {}).get("enemyId")) or None, "opponent": text((row or {}).get("enemyName")),
+                         "score": (row or {}).get("score"), "enemyScore": (row or {}).get("enemyScore"), "targetScore": (row or {}).get("targetScore"),
+                         "endsAt": ms((row or {}).get("end")), "observedAt": observed("targets:current-war-context", 60)}
+
+    async def chain():
+        async def load():
+            payload, status = await data.fetch_json("https://api.torn.com/v2/faction/chain", headers={"Authorization": f"ApiKey {data.TORN_API_KEY}"})
+            if status != 200 or not isinstance(payload, dict) or payload.get("error") or not isinstance(payload.get("chain"), dict):
+                raise data.PortalDataError("Chain unavailable")
+            return {"raw": payload["chain"], "at": safe_int(payload.get("timestamp")) or int(time.time())}
+        cached = await data._cached("extension:chain", 10, load)
+        raw, at = cached["raw"], cached["at"]
+        if type(raw.get("current")) is not int or raw["current"] < 0:
+            raise data.PortalDataError("Chain unavailable")
+        count = raw["current"]
+        goal = next((v for v in (10,25,50,100,250,500,1000,2500,5000,10000,25000,50000,100000) if v > count), count + 1)
+        timeout = safe_int(raw.get("timeout"))
+        result["chain"] = {"count": count, "goal": goal, "id": safe_int(raw.get("id")) or None, "startedAt": ms(raw.get("start")),
+                           "expiresAt": (at + timeout) * 1000 if count > 0 and safe_int(raw.get("cooldown")) <= at and 0 < timeout <= 3600 else None, "observedAt": at * 1000}
+
+    async def targets():
+        source, presence = await asyncio.gather(data.targets_data(identity.guild.id, identity.member.id), data.target_status_data())
+        if safe_int((source.get("war") or {}).get("id")) != safe_int(presence.get("warId")):
+            result["issues"]["targets"] = "BOSBOT war changed; waiting for a consistent roster"
+            return
+        result["targets"] = map_targets(source, presence)
+
+    async def stocks():
+        source = await data._cached("restock:all", 60, data._restock_source)
+        result["stocks"] = [stock_item(item, country["name"]) for country in source["countries"] for item in country["items"] if safe_int(item.get("itemId")) > 0][:200]
+        saved, legacy = await asyncio.gather(list_restock_favorites_v2(identity.member.id), data.get_user_restock_favorites(identity.member.id))
+        for favorite in saved[:50]:
+            if not favorite.get("is_active", True):
+                continue
+            for stock in result["stocks"]:
+                if (str(favorite.get("item_id") or "") == str(stock["itemId"]) or str(favorite.get("item_name") or "").casefold() == stock["name"].casefold()) and (not favorite.get("country") or str(favorite.get("country") or "").casefold() in {stock["country"].casefold(), next((c["code"] for c in source["countries"] if c["name"] == stock["country"]), "")}):
+                    result["favorites"].append({"itemId": stock["itemId"], "name": stock["name"], "country": stock["country"], "minimumStock": max(1,min(10000,safe_int(favorite.get("minimum_stock")) or 1)), "alert": bool(favorite.get("is_active", True))})
+                    if favorite.get("country"):
+                        break
+
+        codes = {country["name"]: country["code"] for country in source["countries"]}
+        selected = {(favorite["itemId"], favorite["country"]) for favorite in result["favorites"]}
+        for stock in result["stocks"]:
+            if (codes.get(stock["country"]), stock["name"].casefold()) in legacy and (stock["itemId"], stock["country"]) not in selected:
+                result["favorites"].append({"itemId": stock["itemId"], "name": stock["name"], "country": stock["country"], "minimumStock": 1, "alert": True})
+                selected.add((stock["itemId"], stock["country"]))
+        result["favorites"] = result["favorites"][:50]
+
+    async def personal():
+        own = await personal_data(identity.guild.id, identity.member.id)
+        result["travel"], result["player"] = own["travel"], own["player"]
+        if own.get("issue"):
+            result["issues"]["travel"] = own["issue"]
+
+    async def company():
+        result["company"] = await company_summary(identity.member.id)
+
+    jobs = []
+    for key, loader, permission in (("war",war,allowed.get("war_report")), ("chain",chain,allowed.get("war_report") or allowed.get("faction")),
+                                    ("targets",targets,allowed.get("targets")), ("stocks",stocks,allowed.get("restock")), ("travel",personal,allowed.get("home")), ("company",company,allowed.get("company"))):
+        if permission:
+            jobs.append(section(key, loader))
+        else:
+            result["issues"][key] = "Your BOSBOT account does not have access to this section"
+    await asyncio.gather(*jobs)
+    return result
