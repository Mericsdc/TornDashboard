+import asyncio
+import json
+import os
+import tempfile
+import time
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import aiosqlite
+from aiohttp import web
+from aiohttp.test_utils import TestClient, TestServer
+from core import database
+from dashboard import extension_storage as storage, extension_feed as feed, extension_api
+from dashboard.auth import SessionData, DashboardIdentity
+from dashboard.server import api_errors, security_headers
+from dashboard.schema import PORTAL_PAGE_DEFAULTS
+
+EXT_ID = "a" * 32
+
+
+def identity(user_id=22):
+    return DashboardIdentity(SessionData(11, user_id, "test-csrf", int(time.time()) + 3600),
+                             SimpleNamespace(id=11), SimpleNamespace(id=user_id, __str__=lambda s: "Member"), False, False)
+
+
+class ExtensionDeviceTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.old_db = database.DB_PATH
+        database.DB_PATH = os.path.join(self.tmp.name, "test.db")
+        async with aiosqlite.connect(database.DB_PATH) as db:
