@@ -0,0 +1,111 @@
+"""Private extension views sourced only from BOSBOT's verified account and caches."""
+import asyncio
+import hashlib
+import time
+from copy import deepcopy
+
+from core.storage import get_raw_key
+from core.utils import safe_int
+from dashboard import data
+from dashboard.connection_storage import portal_account
+from dashboard.storage import user_torn_link
+from monitors import restock
+from services.company import _selection, employee_row
+
+_CACHE = {}
+_LOCKS = {}
+
+
+def country_name(value):
+    value = str(value or '').strip()
+    aliases = {'united arab emirates': 'UAE', 'uae': 'UAE', 'uk': 'United Kingdom'}
+    return aliases.get(value.casefold(), next((v.split(' ', 1)[-1] for v in restock.COUNTRY_NAMES.values() if v.split(' ', 1)[-1].casefold() == value.casefold()), value))
+
+
+def travel_row(status, travel, observed_at):
+    state = str(status.get('state') or 'Unknown')
+    description = str(status.get('description') or '')[:150]
+    if state in {'Unknown', '', 'None'}:
+        return None
+    active = state in {'Traveling', 'Travelling', 'Abroad', 'Returning'}
+    destination = country_name(travel.get('destination'))
+    returning = state == 'Returning' or 'returning' in description.casefold() or (active and destination == 'Torn')
+    described_country = next((v.split(' ', 1)[-1] for v in restock.COUNTRY_NAMES.values() if v.split(' ', 1)[-1].casefold() in description.casefold()), None)
+    if not described_country:
+        described_country = 'UAE' if 'united arab emirates' in description.casefold() else None
+    if not active:
+        destination = 'Torn'
+    elif not destination:
+        destination = 'Torn' if returning else described_country or 'Unknown destination'
+    arrival = safe_int(travel.get('arrival_at'))
+    # Faction status.until is not a reliable flight arrival timestamp.
+    return {'active': active, 'origin': described_country or 'Unknown origin' if returning else 'Torn',
+            'destination': destination, 'arrivesAt': arrival * 1000 if active and state != 'Abroad' and arrival > observed_at else None,
+            'state': state, 'description': description, 'observedAt': observed_at * 1000}
+
+
+async def personal_data(guild_id, user_id):
+    account, key = await asyncio.gather(portal_account(user_id), get_raw_key(user_id))
+    if key and account and account.get('tornConnected'):
+        fingerprint = hashlib.sha256(key.encode()).hexdigest()
+        async with _LOCKS.setdefault(user_id, asyncio.Lock()):
+            now = int(time.time())
+            cached = _CACHE.get(user_id)
+            if cached and cached[0] == fingerprint and now - cached[1] < 20:
+                return deepcopy(cached[2])
+            async def selection(name):
+                payload, code = await data.fetch_json('https://api.torn.com/v2/user/' + name,
+                                                      headers={'Authorization': 'ApiKey ' + key}, timeout=8, retries=0)
+                if code != 200 or not isinstance(payload, dict) or payload.get('error'):
+                    raise data.PortalDataError('Private travel unavailable')
+                return payload.get(name) or {}
+            profile, travel = await asyncio.gather(selection('profile'), selection('travel'))
+            if not safe_int(account.get('torn_id')) or safe_int(profile.get('id')) != safe_int(account.get('torn_id')):
+                raise data.PortalDataError('Private account mismatch')
+            result = {'travel': travel_row(profile.get('status') or {}, travel, now),
+                      'player': {'level': safe_int(profile.get('level')) or None}}
+            if result['travel'] is None:
+                result['issue'] = 'BOSBOT cannot confirm your current travel status'
+            _CACHE[user_id] = (fingerprint, now, deepcopy(result))
+            return result
+    # Members without a personal key can still use the shared faction observation.
+    link = await user_torn_link(guild_id, user_id)
+    members = await data._cached('faction:members', 60, data._faction_members_source) if link else {}
+    member = members.get(safe_int((link or {}).get('torn_id')))
+    if not member:
+        return {'travel': None, 'player': {'level': None}, 'issue': 'Connect your Torn account on BOSBOT for automatic travel detection'}
+    at = int((time.time() - max(0, 60 - (data._CACHE.get('faction:members', (time.monotonic(),))[0] - time.monotonic()))))
+    return {'travel': travel_row(member.get('status') or {}, {}, at), 'player': {'level': safe_int(member.get('level')) or None}}
+
+
+async def company_summary(user_id):
+    account, key = await asyncio.gather(portal_account(user_id), get_raw_key(user_id))
+    unavailable = {'isDirector': False, 'name': '', 'observedAt': None, 'employees': []}
+    if not key or not account or not account.get('tornConnected'):
+        return unavailable
+    fingerprint = hashlib.sha256(key.encode()).hexdigest()
+    cache_id = f'extension:company:{user_id}:{fingerprint}'
+    async def profile_source():
+        payload = await _selection('profile', key)
+        return {'profile': payload.get('company') or payload.get('profile') or {}, 'at': int(time.time())}
+    own = await data._cached(cache_id + ':profile', 60, profile_source)
+    profile = own['profile']
+    if not safe_int(account.get('torn_id')) or safe_int((profile.get('director') or {}).get('id')) != safe_int(account.get('torn_id')) or not safe_int(profile.get('id')):
+        return unavailable
+    async def employee_source():
+        response = await _selection('employees', key)
+        values = response.get('employees') or []
+        if isinstance(values, dict):
+            values = [{**v, 'id': v.get('id', k)} for k, v in values.items() if isinstance(v, dict)]
+        return {'employees': values if isinstance(values, list) else [], 'at': int(time.time())}
+    source = await data._cached(cache_id + ':employees:' + str(profile['id']), 180, employee_source)
+    rows = []
+    for raw in source['employees'][:100]:
+        if not isinstance(raw, dict) or not safe_int(raw.get('id')):
+            continue
+        row = employee_row(raw, source['at'])
+        value = row.get('addictionPenalty')
+        rows.append({'id': safe_int(row['id']), 'name': str(row.get('name') or '')[:80],
+                     'addictionEffect': value if type(value) in (int, float) else None})
+    return {'isDirector': True, 'name': str(profile.get('name') or '')[:100],
+            'observedAt': source['at'] * 1000, 'employees': rows}
