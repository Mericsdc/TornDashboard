{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["node", "chrome"],
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "resolveJsonModule": true,
    "esModuleInterop": true, "allowImportingTsExtensions": true, "noEmit": true
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
