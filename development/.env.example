# Copy to .env. No Torn API key is accepted by the backend.
HOST=127.0.0.1
PORT=4318
# Empty means volatile in-memory storage/cache; configured failures stop startup.
DATABASE_URL=
REDIS_URL=
# Required for non-loopback binding. Used by standalone development API clients; the Chrome extension uses BOSBOT only.
COMPANION_TOKEN=
# Comma-separated exact extension origins, e.g. chrome-extension://<your-id>
# Empty permits extension origins only on loopback in mock development.
ALLOWED_ORIGINS=
