{
  "manifest_version": 3,
  "name": "TornDashboard",
  "version": "0.4.0",
  "description": "Personal Torn API dashboard with travel shopping, bag profit and war widgets.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.torn.com/*",
    "https://torn.com/*",
    "https://api.torn.com/*"
  ],
  "optional_host_permissions": [
    "https://yata.yt/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.torn.com/*",
        "https://torn.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Open TornDashboard settings"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "128": "icon.png"
  }
}
